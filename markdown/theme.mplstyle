# merino book - matplotlib theme
# Loaded via plt.style.use("theme.mplstyle") at the top of each chapter.

# Figure
figure.figsize: 10, 6
figure.dpi: 100
savefig.dpi: 150
savefig.bbox: tight

# Fonts
font.size: 11
axes.titlesize: 14
axes.labelsize: 12
mathtext.fontset: dejavusans

# Axes appearance (whitegrid-style)
axes.facecolor: white
axes.edgecolor: 0.15
axes.linewidth: 1.0
axes.grid: True
grid.color: 0.92
grid.linestyle: -
grid.linewidth: 0.8

# Spines: keep all four
axes.spines.top: True
axes.spines.right: True

# Ticks
xtick.color: 0.15
ytick.color: 0.15
xtick.direction: out
ytick.direction: out

# Lines
lines.linewidth: 2
lines.markersize: 6

# Categorical color cycle (matplotlib tab10, made explicit)
axes.prop_cycle: cycler('color', ['1f77b4', 'ff7f0e', '2ca02c', 'd62728', '9467bd', '8c564b', 'e377c2', '7f7f7f', 'bcbd22', '17becf'])

# Scatter defaults
scatter.edgecolors: white
